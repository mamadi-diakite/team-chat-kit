{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=App_Data/team-chat-kit.db"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Jwt": {
    "Issuer": "team-chat-kit",
    "Audience": "team-chat-kit",
    "AccessTokenMinutes": 60
  },
  "TeamChat": {
    "RoutePrefix": "/api/chat",
    "TablePrefix": "Chat"
  }
}
